# Copy this file to `.env` and fill in the values.
# See README.md for the end-to-end setup walkthrough.
#
# CLIENT_ID / CLIENT_SECRET — OAuth2 credentials from the Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials?project=gracias-totales-1560947364062
# CALENDAR_ID  — the calendar's email address (usually your Gmail).
# EVENT_ID     — the event ID; extract by base64-decoding the path segment of
#                a calendar /eventedit/ URL (see README.md).
# REFRESH_TOKEN — mint with `just auth-url` then `just refresh-token <CODE>`.

export VITE_CLIENT_ID=''
export VITE_CLIENT_SECRET=''
export VITE_CALENDAR_ID=''
export VITE_EVENT_ID=''
export VITE_REFRESH_TOKEN=''
